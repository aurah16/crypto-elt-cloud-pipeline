#!pip install snowflake-connector-python
import os
import sys
import logging
import requests
import pandas as pd
import time
import snowflake.connector
from snowflake.connector.pandas_tools import write_pandas
from datetime import datetime, timezone
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives import serialization  
print("1")
# ==============================================================================
# CONFIGURACIÓN DEL FRAMEWORK DE LOGGING (Estándar de Producción)
# ==============================================================================
# Configuramos el logger para que muestre el tiempo exacto, el nivel de severidad y el mensaje.
# En un servidor Linux, apuntarías 'filename' a un archivo real (ej. '/var/log/crypto_pipeline.log')
# Definimos el nombre del archivo donde se guardará el historial
#LOG_FILE_NAME = 'pipeline_crypto.log'

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] (%(filename)s): %(message)s',
    handlers=[
        # Canal 1: Mantiene la visibilidad en tiempo real en la consola de Colab
        logging.StreamHandler(sys.stdout), 
        # Canal 2: Guarda la data físicamente. mode='a' (Append) escribe al final sin borrar días previos.
        # encoding='utf-8' garantiza que los caracteres como acentos o emojis no se rompan.
        #logging.FileHandler(LOG_FILE_NAME, mode='a', encoding='utf-8')     
        ]
)
logger = logging.getLogger(__name__)

# Catálogo a las 10 principales criptomonedas del mercado
target_cryptos = [
    'bitcoin', 'ethereum', 'tether' #, 'binancecoin', 'solana'
    #'ripple', 'usd-coin', 'dogecoin', 'cardano', 'shiba-inu'
]
historical_records = []

logger.info("Iniciando fase de extracción de datos desde la API de CoinGecko...")

for coin in target_cryptos:
    
    url = f"https://api.coingecko.com/api/v3/coins/{coin}/market_chart?vs_currency=usd&days=30&interval=daily"
    
    try: 
      # Colocamos un timeout estricto para evitar que el script se quede colgado eternamente
        response = requests.get(url, timeout=10)

        # Lógica de control basada en Códigos de Estado HTTP
        if response.status_code == 429:
            logger.warning(f"Límite de peticiones alcanzado (Error 429) al consultar: {coin}. Se sugiere activar Throttling.")
            continue
        elif response.status_code != 200:
            logger.error(f"Falla en API para {coin}. HTTP Status: {response.status_code}. Pasando al siguiente activo.")
            continue
          
        data = response.json()
        prices = data.get('prices', []) # Uso de .get() seguro para evitar KeyErrors si el JSON muta
        market_caps = data.get('market_caps', []) 

        # Iteramos usando el índice para cruzar precio y market cap de la misma fecha
        for i in range(len(prices)):
            timestamp_ms = prices[i][0]
            price = prices[i][1]
            mcap = market_caps[i][1] # Extraemos el market cap del mismo timestamp

            date_converted = datetime.fromtimestamp(timestamp_ms / 1000, tz=timezone.utc)
            
            historical_records.append({
                'SNAPSHOT_TIME': timestamp_ms * 1000000, # Lo pasamos a nanosegundos para mantener tu formato actual
                'ID': coin,
                'SYMBOL': coin[:3].upper(), # Estándar rápido de símbolo
                'NAME': coin.capitalize(),
                'CURRENT_PRICE': float(price),
                'MARKET_CAP': float(mcap) # Nueva columna que viaja a Snowflake
            })

            # Pausa de 20 segundos para respetar los límites de la API gratuita de CoinGecko
            #time.sleep(20)

    except requests.exceptions.Timeout:
        logger.error(f"Falla de Timeout por límite de tiempo excedido al conectar con CoinGecko para: {coin}")
    except requests.exceptions.RequestException as e:
        logger.error(f"Error de red crítico en la petición de {coin}: {str(e)}")
    except Exception as e:
        logger.error(f"Error inesperado procesando los datos de {coin}: {str(e)}")

# Validamos que tengamos datos para continuar; si la lista está vacía, abortamos limpiamente
if not historical_records:
    logger.critical("No se recuperaron registros válidos de la API. Abortando ejecución del pipeline.")
    sys.exit(1)

df_history = pd.DataFrame(historical_records)
logger.info(f"Fase de extracción completada con éxito. DataFrame estructurado con {len(df_history)} filas.")

# ==============================================================================
# CONEXIÓN SEGURA E INYECCIÓN EN SNOWFLAKE CLOUD
# ==============================================================================
logger.info("Iniciando fase de persistencia. Conectando a Snowflake Cloud...")
conn = None # Inicializamos la variable para el control del bloque finally
try:
    #  Leer la clave privada desde el archivo local de Colab
    with open("rsa_key.p8", "rb") as key_file:
        p_key = serialization.load_pem_private_key(
            key_file.read(),
            password=None, # Pon la contraseña si decidiste cifrarla al crearla
            backend=default_backend()
        )

    private_key_bytes = p_key.private_bytes(
        encoding=serialization.Encoding.DER,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption()
    )

    conn = snowflake.connector.connect(
        user='xxxx',
        password='xxx',
        account='xxx',
        private_key=private_key_bytes,
        warehouse='CRYPTO_WH',
        database='CRYPTO_CLOUD_DB',
        schema='RAW'
    )
    logger.info("Conexión establecida. Ejecutando inyección masiva vía write_pandas...")
    
    success, nchunks, nrows, _ = write_pandas(
        conn=conn,
        df=df_history,
        table_name='CRYPTO_PRICES',
        auto_create_table=True
    )
    
    if success:
        logger.info(f"¡Persistencia exitosa! Se añadieron {nrows} registros en la tabla RAW.CRYPTO_PRICES en {nchunks} bloques.")
    else:
        logger.error("Snowflake reportó que la operación write_pandas no se completó correctamente.")

except snowflake.connector.errors.DatabaseError as e:
    logger.error(f"Falla crítica de base de datos en Snowflake (Credenciales/Red/Permisos): {str(e)}")
except Exception as e:
    logger.error(f"Error inesperado durante la fase de carga en el Data Warehouse: {str(e)}")

finally:
    # Garantizar el cierre del socket
    if conn is not None and not conn.is_closed():
        conn.close()
        logger.info("Recursos de infraestructura liberados: Conexión a Snowflake cerrada de forma segura.")

