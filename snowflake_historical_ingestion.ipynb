import requests
import pandas as pd
import snowflake.connector
from snowflake.connector.pandas_tools import write_pandas
from datetime import datetime, timezone

# 1. Monedas que queremos traer al pasado para poblar las series temporales
target_cryptos = ['bitcoin', 'ethereum', 'solana']
historical_records = []

print(" Extrayendo el historial de los últimos 30 días desde la API...")

for coin in target_cryptos:
    url = f"https://api.coingecko.com/api/v3/coins/{coin}/market_chart?vs_currency=usd&days=30&interval=daily"

    response = requests.get(url, timeout=10)
    if response.status_code == 200:
        data = response.json()
        prices = data['prices']

        for record in prices:
            timestamp_ms = record[0]
            price = record[1]

            # Convertimos el timestamp de milisegundos a una fecha legible de Python
            date_converted = datetime.fromtimestamp(timestamp_ms / 1000, tz=timezone.utc)

            historical_records.append({
                'SNAPSHOT_TIME': date_converted,
                'ID': coin,
                'SYMBOL': 'btc' if coin == 'bitcoin' else ('eth' if coin == 'ethereum' else 'sol'),
                'NAME': coin.capitalize(),
                'CURRENT_PRICE': float(price)
            })
    else:
        print(f" Error al consultar {coin}: Código de estado {response.status_code}")

# Convertimos la lista de diccionarios en un DataFrame limpio
df_history = pd.DataFrame(historical_records)

# 2. Conexión e Inyección en la NUEVA tabla en Snowflake Cloud
print("❄️ Conectando a Snowflake para inyectar los datos históricos...")
conn = snowflake.connector.connect(
    user='USUARIO',
    password='CONTRASEÑA',
    account='ACOUNT_NAME',
    warehouse='NAME_WH',
    database='NAME_DB',
    schema='SCHEMA_NAME'
)

# Inyectamos en la tabla aislada CRYPTO_PRICES
success, nchunks, nrows, _ = write_pandas(
    conn=conn,
    df=df_history,
    table_name='CRYPTO_PRICES',
    auto_create_table=True
)

print(f" ¡Historial cargado con éxito! Se añadieron {nrows} registros en la nueva tabla RAW.CRYPTO_PRICES.")
conn.close()
